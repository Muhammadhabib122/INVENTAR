# ===== FarDTU Inventarizatsiya sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring. .env git'ga qo'shilmaydi.

# Baza paroli (uzun, tasodifiy parol yozing)
POSTGRES_PASSWORD="PAROLNI_ALMASHTIRING"

# Birinchi admin (docker compose exec app node prisma/seed.mjs buyrug'i ishlatadi)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="kamida-10-belgili-parol"
ADMIN_FULLNAME="Administrator"

# Sayt manzili: Caddy shu domenga HTTPS sertifikat oladi
DOMAIN="inventar.example.uz"

# Cookie faqat HTTPS orqali yuborilsin (HTTPS ulangan bo'lsa "true")
COOKIE_SECURE="true"

# Zaxira nusxalar necha kun saqlansin
BACKUP_KEEP_DAYS=30

# Faqat Docker'siz (lokal) ishga tushirishda kerak. Docker Compose buni o'zi belgilaydi.
DATABASE_URL="postgresql://inventar:PAROLNI_ALMASHTIRING@localhost:5432/inventar"
